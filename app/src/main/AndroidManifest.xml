<manifest
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"  />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.VIBRATE" />
<uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    
    
    
   <application
        android:name="com.socksfast.sockshttp.MyApplication"
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name="com.socksfast.sockshttp.LauncherActivity"
			android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
			android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <activity
			android:exported="false"
            android:name="com.socksfast.sockshttp.errors"
            android:label="@string/app_name"/>
          
		
	   <activity android:name="com.socksfast.sockshttp.servers.ServersActivity"
			android:parentActivityName="com.socksfast.sockshttp.MainActivity"
			android:label="Servidores"/>
		
          	<activity

				android:name="com.seta.ide.v3"
			android:label="@string/app_name" />

		<service
			android:name="com.socksfast.ultrasshservice.V2Service"
			android:exported="false"
			android:label="@string/app_name"
			android:permission="android.permission.BIND_VPN_SERVICE"
			android:process=":RunSoLibV2RayDaemon">
			<intent-filter>
				<action android:name="android.net.VpnService" />
			</intent-filter>
			<meta-data
				android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
				android:value="true" />
		</service>
        
        
        
        <activity
            android:name="com.socksfast.sockshttp.MainActivity"
			android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
			android:exported="false">
			<intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
            </intent-filter>
		</activity>
        
        <service
			android:name="com.socksfast.ultrasshservice.tunnel.V2Proxy"
			android:exported="false"
			android:label="@string/app_name"
			android:process=":RunSoLibV2RayDaemon" />

        <activity
            android:name="com.socksfast.sockshttp.activities.ConfigGeralActivity"
			android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:label="@string/settings"
			android:exported="false"
			android:parentActivityName="com.socksfast.sockshttp.MainActivity">

            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.socksfast.sockshttp.MainActivity"/>
			
		</activity>

        <activity
            android:name="com.socksfast.ultrasshservice.LaunchVpn"
			android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:theme="@style/AppThemeLogin"
			android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <receiver android:name="com.socksfast.ultrasshservice.MainReceiver"
			android:exported="false">
            <intent-filter>
                <action android:name="com.socksfast.ultrasshservice.MainReceiver.ACTION_SERVICE_STOP">
                </action>
                <action android:name="com.socksfast.ultrasshservice.MainReceiver.ACTION_SERVICE_RESTART">
                </action>
            </intent-filter>
        </receiver>

        <service
            android:label="@string/app_name"
            android:name="com.socksfast.ultrasshservice.tunnel.vpn.TunnelVpnService"
            android:exported="false"
            android:enabled="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
        
         <meta-data
			android:name="com.google.firebase.messaging.default_notification_icon"
			android:resource="@drawable/icon" />

        <service
            android:label="SocksHttp Service"
            android:name="com.socksfast.ultrasshservice.SocksHttpService"
            android:stopWithTask="false"
            android:exported="false"/>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7111583066993872~6665720047"/>

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false"/>

    </application>

</manifest>
