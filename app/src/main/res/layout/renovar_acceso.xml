<androidx.cardview.widget.CardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="wrap_content"
     app:cardElevation="3dp"
     app:cardUseCompatPadding="true"
     android:layout_marginLeft="20dp"
     android:layout_marginRight="20dp"
     app:cardBackgroundColor="#202020"
     app:cardCornerRadius="@dimen/size_16"
     android:id="@+id/main_card">

    <androidx.constraintlayout.widget.ConstraintLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:padding="@dimen/size_15">

        <RelativeLayout
             android:layout_height="32dp"
             android:layout_width="32dp"
             android:background="@drawable/dialog_circle_bg"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             android:id="@+id/appButton1">

            <ImageView
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:layout_centerInParent="true"
                 android:background="@drawable/ic_close" />

        </RelativeLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:gravity="center_horizontal"
             android:padding="@dimen/size_15"
             android:orientation="vertical"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toBottomOf="@+id/bt_close"
             android:id="@+id/center_block">

            <ImageView
                 android:layout_height="80dp"
                 android:layout_width="80dp"
                 app:srcCompat="@drawable/icon" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textAppearance="@style/TextAppearance.AppCompat.Large"
                 android:textColor="@color/grey_90"
                 android:layout_marginTop="@dimen/size_10"
                 android:text="@string/app_name"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center_horizontal"
                 android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                 android:textColor="#909080"
                 android:layout_marginTop="@dimen/size_10"
                 android:text="Si deseas renovar el tiempo restante que te queda en la app  toca el botón de la parte de abajo para agregar 2 horas más" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="10dp"
                 android:gravity="center"
                 android:background="@drawable/gris2"
                 android:padding="5dp"
                 android:orientation="horizontal"
                 app:cardElevation="10dp"
                 android:layout_marginTop="10dp"
                 app:cardCornerRadius="10dp"
                 android:id="@+id/hadsButton">

                <ImageView
                     android:layout_height="40dp"
                     android:layout_width="30dp"
                     android:src="@drawable/ad"
                     android:layout_marginLeft="10dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="#00000000"
                     android:textSize="18dp"
                     android:textColor="#FFFFFFFF"
                     android:layout_marginLeft="20dp"
                     android:layout_marginRight="20dp"
                     android:layout_alignParentStart="true"
                     android:textStyle="bold"
                     android:text="Ver Anuncio" />

                <ImageView
                     android:layout_height="40dp"
                     android:layout_width="30dp"
                     android:src="@drawable/play"
                     android:layout_marginRight="10dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>